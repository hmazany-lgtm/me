# ─── DATABASE ──────────────────────────────────────────────────────────────────
# Local dev: SQLite (file-based, zero setup)
DATABASE_URL="file:./dev.db"

# Production on Vercel: use a serverless Postgres provider
# Recommended options (all have free tiers):
#   - Neon:      https://neon.tech       → postgresql://user:pass@host/db?sslmode=require
#   - Supabase:  https://supabase.com    → postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#   - Vercel PG: https://vercel.com/storage/postgres
#
# DATABASE_URL="postgresql://user:password@host:5432/tfa_survey?sslmode=require"


# ─── AUTH ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="change-me-in-production-use-openssl-rand-base64-32"


# ─── SEED ───────────────────────────────────────────────────────────────────────
# Used only on first run of POST /api/seed
SEED_ADMIN_EMAIL="admin@tfa.sa"
SEED_ADMIN_PASSWORD="TFA@admin2025"
SEED_ADMIN_NAME="TFA Super Admin"


# ─── APP (optional) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
