# Mustafa – environment configuration
# The demo runs fully without any of these set (deterministic engine + client store).

# Optional: connect a hosted AI model (Claude-compatible). When present, the
# provider abstraction in src/lib/ai/provider.ts routes to the model.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_API_KEY=

# Optional: PostgreSQL / Supabase database for the production data model
# (see prisma/schema.prisma).
# DATABASE_URL=postgresql://user:password@localhost:5432/mustafa
